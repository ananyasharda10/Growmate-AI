# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Groq API key for the AI Advisor (console.groq.com). Server-only — no VITE_ prefix, since
# that would bundle it into the public client JS. Used by api/advisor.ts, read via
# `vercel dev` locally or as a Vercel project environment variable when deployed.
GROQ_API_KEY=
